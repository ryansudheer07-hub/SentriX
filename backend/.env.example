# ---------------------------------------------------------------------------
# Traffic Correlation Engine (§3.5)
# ---------------------------------------------------------------------------
# Capture mode. With TRAFFIC_CAPTURE_ENABLED=false and no PCAP_REPLAY_PATH the
# engine seeds deterministic demo fixtures — /traffic/* works with zero setup.
TRAFFIC_CAPTURE_ENABLED=false
TSHARK_PATH=tshark
TSHARK_INTERFACE=
TSHARK_CAPTURE_FILTER=tcp port 8333
# A .pcap/.pcapng (parsed via tshark) or a .jsonl of TrafficEvent lines.
PCAP_REPLAY_PATH=

# Correlation window + hard memory bound.
TRAFFIC_WINDOW_SECONDS=60
TRAFFIC_MAX_EVENTS=50000

# Burst detection: score ramps 0 -> 1 as the rate goes from BASELINE to
# BASELINE * THRESHOLD_RATIO (events per second).
TRAFFIC_BURST_BASELINE_RATE=2.0
TRAFFIC_BURST_THRESHOLD_RATIO=3.0

# Peers within this many ms count as "near-simultaneous"; peer counts above
# EXPECTED_FANOUT raise the propagation-irregularity feature.
TRAFFIC_NEAR_SIMULTANEOUS_MS=60
TRAFFIC_EXPECTED_FANOUT=8

# Explainable anomaly score = weighted sum of the four features.
TRAFFIC_WEIGHT_BROADCAST_TIMING=0.20
TRAFFIC_WEIGHT_BURST=0.30
TRAFFIC_WEIGHT_PEER_CONCENTRATION=0.25
TRAFFIC_WEIGHT_PROPAGATION_IRREGULARITY=0.25
