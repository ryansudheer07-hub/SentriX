# Auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Neo4j (leave blank to run in mock-data mode against the graph store)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Live rescoring loop
RESCORE_INTERVAL_MINUTES=5

# Audit log file
AUDIT_LOG_PATH=audit.log
